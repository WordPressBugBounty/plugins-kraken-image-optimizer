msgstr "JPEG"

#: includes/class-kraken-io-settings.php:816
#: includes/class-kraken-io-summary.php:173
msgid "PNG"
msgstr "PNG"

#: includes/class-kraken-io-settings.php:817
#: includes/class-kraken-io-summary.php:174
